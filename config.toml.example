# StreamGo configuration. Copy to config.toml (or /etc/streamgo/config.toml, or pass --config).
# Every setting below shows its default. Any setting can be overridden by an environment variable named
# STREAMGO_<SECTION>_<KEY>, e.g. STREAMGO_SERVER_ADDR=":9090" (lists are comma-separated).
#
# Secrets are read ONLY from the environment, or from <data_dir>/streamgo.env (NAME=value lines, which `streamgo up`
# creates on its first start) for a variable the environment lacks, and are refused in this file:
#   STREAMGO_SECRET_KEY           32 random bytes in base64; seals destinations and invite links (required)
#   STREAMGO_DATABASE_DSN         connection string for mariadb or postgres
#   STREAMGO_LIVEKIT_API_KEY      LiveKit API key
#   STREAMGO_LIVEKIT_API_SECRET   LiveKit API secret
#   STREAMGO_MEDIAMTX_USER        user StreamGo authenticates to MediaMTX with
#   STREAMGO_MEDIAMTX_SECRET      its password

[server]
# Address the HTTP server listens on.
addr = ":8080"
# Public URL browsers use. Must be https://, except on localhost and loopback addresses (development):
# browsers allow camera and microphone only on secure origins. State-changing requests must carry this origin.
public_url = "http://localhost:8080"
# Data directory: the SQLite database, uploaded assets, the instance lock (streamgo.lock) and streamgo.env (the flag
# --data-dir of every command overrides it).
data_dir = "./data"
# IPs or CIDRs of reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers are trusted.
trusted_proxies = []
# HTTPS from the binary, with no reverse proxy: a PEM certificate chain and its PEM key. Both or neither.
# They win over self_signed. With HTTPS on, public_url must be https://.
cert_file = ""
key_file = ""
# HTTPS with a certificate StreamGo generates under <data_dir>/tls for the host of public_url, localhost and the
# loopback addresses (one year, renewed 30 days before it ends). Browsers warn once per device.
self_signed = false

[database]
# sqlite, mariadb or postgres. MariaDB and PostgreSQL take their connection string from STREAMGO_DATABASE_DSN.
driver = "sqlite"
# SQLite file; empty: <data_dir>/streamgo.db.
path = ""

[livekit]
# WebSocket URL browsers use to reach LiveKit. Empty: the server's own origin with /livekit (wss:// under HTTPS),
# which StreamGo proxies to api_url, so LiveKit's signalling can stay on the loopback address.
url = "ws://localhost:7880"
# HTTP URL the server uses for LiveKit's API.
api_url = "http://localhost:7880"

[mediamtx]
# HTTP base URL of MediaMTX's WebRTC (WHIP) server, reached by the server only.
whip_url = "http://localhost:8889"
# RTSP base URL ffmpeg reads the program from and writes the transcoded stream to.
rtsp_url = "rtsp://localhost:8554"
# HTTP base URL of MediaMTX's control API (internal network only): it closes ingest sessions nobody tracks.
api_url = "http://localhost:9997"

[studio]
# Participants in a studio room, the owner included (2 to 100).
max_participants = 10
# Sources on stage at once (1 to 6).
max_on_stage = 6

[output]
# The ffmpeg binary; it must offer the libx264 and aac encoders, the h264, vp8 and opus decoders, the rtsp
# demuxer, the rtsp, rtp and flv muxers, the tcp, tls, rtmp and rtmps protocols and the scale, pad and format filters.
ffmpeg_path = "ffmpeg"
# An administrator can change resolution, max_resolution and video_bitrate_kbps in the app (Settings, Server); a
# value saved there wins over this file, and an environment variable wins over both.
# Output resolution of new broadcasts (30 fps): 720p, 1080p or 1440p; at most max_resolution. The owner can
# change it per broadcast in the studio, up to max_resolution.
resolution = "720p"
# The highest resolution a broadcast may use. 1440p costs the server about two cores per live broadcast and the
# owner's upload up to 24 Mbit/s; some platforms accept at most 1080p.
max_resolution = "1080p"
# Video bitrate in kbit/s for every resolution (500 to 40000); 0 uses each resolution's own: 4000 for 720p,
# 6000 for 1080p, 12000 for 1440p.
video_bitrate_kbps = 0
# Audio bitrate in kbit/s (64 to 320).
audio_bitrate_kbps = 128
# Destinations per broadcast (1 to 10).
max_destinations = 5
# Broadcasts live at the same time (1 to 32): each one transcodes once.
max_concurrent = 2
# How long going live waits for the program to arrive (5s to 5m).
start_timeout = "30s"
# How long an interrupted broadcast waits for the program to come back before it ends (10s to 30m).
reconnect_grace = "2m0s"
# Allow destinations on loopback, private and link-local addresses (an operator's own RTMP server).
allow_private_destinations = false

[media]
# Used by `streamgo up` only, which runs LiveKit and MediaMTX itself. Browsers reach the three ports below directly:
# open them in the firewall (TCP and UDP for webrtc_port).
# The address the media servers advertise to browsers. Empty: the IPv4 address of the default route, else 127.0.0.1.
# On a host behind NAT, set the public address.
node_ip = ""
# LiveKit's WebRTC media over TCP (1 to 65535).
livekit_tcp_port = 7881
# LiveKit's WebRTC media over UDP (1 to 65535).
livekit_udp_port = 7882
# MediaMTX's WebRTC media, UDP and TCP (1 to 65535; not one of the two LiveKit ports).
webrtc_port = 8189
